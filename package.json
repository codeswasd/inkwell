{
  "name": "inkwell",
  "version": "1.0.0",
  "description": "Lightweight collaborative document editor",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "build:demo": "vite build --mode demo && node scripts/escape-demo.js",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify.mjs",
    "preview:netlify": "node scripts/netlify-local.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.11",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@vitejs/plugin-react": "^6.3.0",
    "diff": "^9.0.0",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "marked": "^18.3.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.5",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
